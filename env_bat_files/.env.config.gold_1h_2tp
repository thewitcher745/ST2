# Structure
lag=9
fib_factor=0.33
zigzag_method=indicator
structure_engine=bulk
timeframe="1h"

# Block setup
min_block_height_percentage=0.1
max_block_height_percentage=3
refined_block_height_percentage=1

# Used to limit the types of blocks that the algorithm processed
# Valid values are "OB", "MB", "BB" or "/" delineated combinations of them
block_types="OB/BB"
block_formation_waiting_method="price_close"
block_preformation_check_method="level_block"

# Target and stoploss setup
target_coeff=3
stoploss_coeff=2.75
target_setup_function="small_blocks_refined_t1_t2_only"
stoploss_setup_function="small_blocks_refined_no_trailing"

# Bounce-related
max_bounces=2
bounce_target_threshold=1

# Capital-related
usdt_per_trade=100
leverage=20
leverage_type=cross

# How many days to go back in history for structure formation
startup_n_days=30
# How often the structure is recalculated in seconds
calc_interval=10

# Backtest related
shutdown=False
