binance_ws_endpoint="wss://stream.binance.com:9443/stream"
telegram_api_endpoint="https://api.telegram.org/"
live_sim_tick_interval=2

# Binance API limits
binance_cache_retry_interval=5
binance_cache_max_retries=5
binance_cache_resync_buffer=5

# Telegram API limits
telegram_api_max_retries=5
telegram_api_base_retry_interval=1
telegram_api_send_message_delay=10

# Binance Websocket limits
ws_error_retry_interval=8
ws_error_max_retries=5

# Append the ID of the position to the signal
validation=True

signal_proximity_check=False
signal_proximity_check_percent=2
