lag=9
fib_factor=0.33
timeframe="15m"
target_coeff=1
stoploss_coeff=1.5
target_setup_function="default"
stoploss_setup_function="default"
min_block_height_percentage=0.1
max_block_height_percentage=3
usdt_per_trade=100
leverage=20
leverage_type=cross

# How many days to go back in history for structure formation
startup_n_days=30
# How often the structure is recalculated
calc_interval=10
